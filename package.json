{
  "name": "han-ngu-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev --webpack -H 127.0.0.1 -p 3000",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build --webpack",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app server lib scripts tests",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "admin": "tsx scripts/admin.ts",
    "backup": "tsx scripts/backup.ts",
    "content:check": "tsx scripts/content-check.ts",
    "audio:targets": "tsx scripts/audio-targets.ts",
    "audio:render": "tsx scripts/voice-command.ts render",
    "audio:reference": "tsx scripts/voice-command.ts reference",
    "audio:check": "tsx scripts/audio-audit.ts",
    "audio:publish": "tsx scripts/audio-publish.ts",
    "audio:backup": "tsx scripts/audio-backup.ts",
    "podcast:render": "\".local\\kokoro-venv\\Scripts\\python.exe\" -B -X utf8 scripts/podcast-radio-render.py",
    "podcast:check": "tsx scripts/podcast-check.ts",
    "podcast:subtitles": "\".local\\kokoro-venv\\Scripts\\python.exe\" -B -X utf8 scripts/podcast-subtitles.py --refresh-pinyin",
    "podcast:backup": "tsx scripts/podcast-check.ts --backup",
    "smoke:production": "tsx scripts/production-smoke.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supertest": "7.3.1",
    "typescript": "6.0.3"
  }
}
