# Local development values only; export into the API process environment.
# The API does not automatically read this file. Next.js reads its own .env files.
# Never commit a populated .env file, database, backup password or AWS keys.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=.local/hanngulab.sqlite
LOCAL_PREVIEW=true
# Production requires an implemented email delivery adapter and HTTPS.
# NODE_ENV=production, LOCAL_PREVIEW=false, APP_ORIGIN=https://<public-host>
# DATABASE_PATH must be on persistent storage outside the checkout/build directory.
# Do not enable preview or insert a no-op email adapter to bypass this guard.
# HNL_BACKUP_PASSWORD is set only in the backup job/secret store; never on the client.
AI_ENABLED=false
