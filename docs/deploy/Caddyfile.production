hanngulab.duckdns.org {
    header -Server
    @private path /.env /.env.* /.git /.git/* /.local /.local/* /server/* /scripts/* /docs/* /content/*
    handle @private {
        respond 404
    }
    handle /__legacy_api_retired {
        header Cache-Control "no-store"
        respond "Legacy API retired. Open the canonical website." 410
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:3001 {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {http.request.host}
            header_up -X-Real-IP
            header_up -Forwarded
            header_up -CF-Connecting-IP
            header_up -CloudFront-Viewer-Address
            header_up -True-Client-IP
        }
    }
    handle {
        root * /srv/han-ngu-lab/current
        header Cache-Control "no-cache"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        file_server
    }
}

54-253-61-113.sslip.io {
    header -Server
    header Cache-Control "no-store"
    header Referrer-Policy "no-referrer"
    @legacyApi path /api /api/*
    redir @legacyApi https://hanngulab.duckdns.org/__legacy_api_retired 302
    redir https://hanngulab.duckdns.org{uri} 302
}
